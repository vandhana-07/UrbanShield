# UrbanShield Backend Environment Configuration
FLASK_ENV=development
PORT=5000

# Mock Mode (Set to false when Member 3's AI Agent server is running)
MOCK_MODE=true

# AI Agent Service URL (Member 3)
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT_SECONDS=6.0

# Database
DATABASE_URL=sqlite:///urbanshield.db
